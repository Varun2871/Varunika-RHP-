import sys
input = sys.stdin.readline

for _ in range(int(input())):
    N = int(input())

    A = []
    diff = []
    total = 0

    for _ in range(N):
        a, b = map(int, input().split())
        total += a
        A.append(a)
        diff.append(b - a)

    diff.sort()
    mn = min(A)

    ans = total
    cur = total

    for k in range(1, N + 1):
        cur += diff[k - 1]
        ans = min(ans, cur + max(0, 2 * k - N) * mn)

    print(ans)
