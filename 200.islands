class Solution {

    // Left, Right, Up, Down
    final int diff[][] = {
        {0, -1},
        {0, 1},
        {-1, 0},
        {1, 0}
    };

    private void dfs(char[][] grid, int R, int C, int row, int col) {

        // Mark current cell as visited
        grid[row][col] = '0';

        // Check all 4 directions
        for (int i = 0; i < 4; i++) {

            int ar = row + diff[i][0];
            int ac = col + diff[i][1];

            // Valid cell and unvisited land
            if…{

                dfs(grid, R, C, ar, ac);
            }
        }
    }

    public int numIslands(char[][] grid) {

        int R = grid.length;
        int C = grid[0].length;

        int islands = 0;

        for (int row = 0; row < R; row++) {

            for (int col = 0; col < C; col++) {

                if (grid[row][col] == '1') {

                    islands++;

                    dfs(grid, R, C, row, col);
                }
            }
        }

        return islands;
    }
}
