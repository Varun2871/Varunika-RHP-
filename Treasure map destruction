import sys
input = sys.stdin.readline

for _ in range(int(input())):
    n = int(input())
    b = list(map(int, input().split()))

    diff = [0] * (n + 1)

    for i, d in enumerate(b):
        if d > 0:
            l = max(0, i - d + 1)
            r = min(n - 1, i + d - 1)
            diff[l] += 1
            diff[r + 1] -= 1

    bad = [0] * n
    cur = 0
    for i in range(n):
        cur += diff[i]
        bad[i] = cur

    ans = ['0'] * n
    ok = True

    for i, d in enumerate(b):
        if d == 0:
            if bad[i]:
                ok = False
                break
            ans[i] = '1'

    if ok:
        for i, d in enumerate(b):
            if d > 0:
                if i-d >= 0 and bad[i-d] == 0:
                    ans[i-d] = '1'
                elif i+d < n and bad[i+d] == 0:
                    ans[i+d] = '1'
                else:
                    ok = False
                    break

    if ok and all(x == -1 for x in b):
        ans[0] = '1'

    print(''.join(ans) if ok else -1)
