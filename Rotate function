class Solution {
public:
    int maxRotateFunction(vector<int>& A) {
        long long sum = 0, F = 0;
        int n = A.size();

        for (int i = 0; i < n; i++) {
            sum += A[i];
            F += (long long)i * A[i];
        }

        long long maxVal = F;

        for (int i = 1; i < n; i++) {
            F += sum - (long long)n * A[n - i];
            maxVal = max(maxVal, F);
        }

        return (int)maxVal;
    }
};
