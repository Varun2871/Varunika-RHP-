class Solution {
public:
    vector<string> findAllConcatenatedWordsInADict(vector<string>& words) {

        sort(words.begin(), words.end(),
             [](auto& a, auto& b) {
                 return a.size() < b.size();
             });

        unordered_set<string> st;
        vector<string> ans;

        for (auto& s : words) {
            int n = s.size();

            vector<bool> dp(n + 1, false);
            dp[0] = true;

            for (int i = 1; i <= n; i++) {
                for (int j = 0; j < i; j++) {

                    if (dp[j] && st.count(s.substr(j, i - j))) {
                        dp[i] = true;
                        break;
                    }
                }
            }

            if (dp[n]) {
                ans.push_back(s);
            }

            st.insert(s);
        }

        return ans;
    }
};
