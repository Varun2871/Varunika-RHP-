class Solution {
public:
    string add(string a, string b) {
        string res;
        int i = a.size() - 1, j = b.size() - 1, carry = 0;

        while (i >= 0 || j >= 0 || carry) {
            int sum = carry;
            if (i >= 0) sum += a[i--] - '0';
            if (j >= 0) sum += b[j--] - '0';

            res += char('0' + sum % 10);
            carry = sum / 10;
        }

        reverse(res.begin(), res.end());
        return res;
    }

    bool check(string a, string b, int pos, string& num) {
        string c = add(a, b);

        if (pos + c.size() > num.size() ||
            num.substr(pos, c.size()) != c)
            return false;

        pos += c.size();

        if (pos == num.size())
            return true;

        return check(b, c, pos, num);
    }

    bool isAdditiveNumber(string num) {
        int n = num.size();

        for (int i = 1; i <= n - 2; i++) {
            if (num[0] == '0' && i > 1) break;

            for (int j = i + 1; j <= n - 1; j++) {
                if (num[i] == '0' && j - i > 1) break;

                string a = num.substr(0, i);
                string b = num.substr(i, j - i);

                if (check(a, b, j, num))
                    return true;
            }
        }

        return false;
    }
};
