#include <bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio;
    cin.tie(nullptr);
    int t;
    cin >> t;
    while(t--){
        int n;
        cin>>n;
        vector<int>a(n);
        int zeros = 0;
        
        for(auto &x: a){
            cin >> x;
            zeros += (x == 0);
        }
        if(zeros < 2){
        cout << "-1"<<'\n';
            
        }
        else{
            cout << a[0] + a[n - 1] <<'\n';
        }
    }
    return 0;
    
}
